<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Voxela3D.PrintCalculator</AssemblyName>
    <RootNamespace>Voxela3D.PrintCalculator</RootNamespace>
    <ApplicationIcon>assets\icons\Voxela.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="assets\fonts\**\*.ttf" />
    <Resource Include="assets\fonts\**\*.ttf" />
    <Resource Include="assets\icons\Voxela.ico" />
  </ItemGroup>
</Project>